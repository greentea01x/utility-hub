# Supabase Connect → Session pooler URI, with sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SESSION_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
JOB_TOKEN=
SEED_ADMIN_PASSWORD=
NODE_ENV=development
PORT=3000
TZ=Asia/Bangkok
# Optional PostgreSQL pool size; keep this low on hosted databases.
DB_POOL_SIZE=10
