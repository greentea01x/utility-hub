<% const scale = chartScale(series.map((point) => point[utility])); const chartWidth = 640; const chartHeight = 175; const plotX = 52; const plotY = 15; const step = chartWidth / 12; %>
<section class="panel chart-panel <%= utility %>">
  <div class="panel-heading"><h2 class="chart-heading"><%- include('emoji', {icon:utility}) %><%= utility === 'water' ? 'การใช้น้ำรายเดือน' : 'การใช้ไฟรายเดือน' %></h2><span class="unit-tag <%= utility %>">หน่วย · 12 เดือน</span></div>
  <div class="chart-body"><svg class="usage-chart <%= utility %>" viewBox="0 0 720 235" role="img" aria-label="<%= utility === 'water' ? 'กราฟการใช้น้ำย้อนหลัง 12 เดือน' : 'กราฟการใช้ไฟฟ้าย้อนหลัง 12 เดือน' %>">
    <% scale.ticks.forEach((tick) => { const y = plotY + chartHeight - tick / scale.max * chartHeight; %><line class="chart-grid" x1="<%= plotX %>" y1="<%= y %>" x2="<%= plotX + chartWidth %>" y2="<%= y %>"/><text class="chart-tick" x="<%= plotX - 10 %>" y="<%= y + 4 %>" text-anchor="end"><%= quantity(tick) %></text><% }) %>
    <% series.forEach((point, index) => { const value = Number(point[utility]); const height = value / scale.max * chartHeight; const x = plotX + index * step + 8; %><rect class="chart-bar <%= index === series.length - 1 ? 'latest' : '' %>" x="<%= x %>" y="<%= plotY + chartHeight - height %>" width="<%= step - 16 %>" height="<%= height %>" rx="3"><title><%= monthLabel(point.period) %>: <%= quantity(value) %> หน่วย</title></rect><text class="chart-month" x="<%= x + (step - 16) / 2 %>" y="<%= plotY + chartHeight + 25 %>" text-anchor="middle"><%= monthLabel(point.period, true).split(' ')[0] %></text><% if (value && index === series.length - 1) { %><text class="bar-label" x="<%= x + (step - 16) / 2 %>" y="<%= plotY + chartHeight - height - 6 %>" text-anchor="middle"><%= quantity(value) %></text><% } %><% }) %>
  </svg><% if (scale.empty) { %><p class="empty-caption">ยังไม่มีข้อมูลการใช้ในช่วง 12 เดือนนี้</p><% } %></div>
  <p class="chart-note">จากเลขมิเตอร์ที่บันทึกไว้ ถึง <%= monthLabel(period) %></p>
</section>
