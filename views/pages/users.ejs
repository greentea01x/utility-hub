<%- include('../partials/shell-start') %>
<div class="page-intro"><div><p class="section-kicker">การจัดการระบบ</p><h1>ผู้ใช้งานระบบ</h1><p>ตรวจสอบบัญชีผู้ดูแลระบบและเจ้าหน้าที่ พร้อมสิทธิ์ในการเข้าถึงข้อมูล</p></div><span class="count-label"><%= users.length %> บัญชี</span></div>
<div class="table-wrap"><table>
  <thead><tr><th>ชื่อผู้ใช้</th><th>ชื่อที่แสดง</th><th>สิทธิ์การใช้งาน</th><th>สถานะบัญชี</th></tr></thead>
  <tbody><% users.forEach((user) => { %><tr><td><strong><%= user.username %></strong></td><td><%= user.display_name %></td><td><span class="badge <%= user.role === 'admin' ? '' : 'muted' %>"><%= user.role === 'admin' ? 'ผู้ดูแลระบบ' : 'เจ้าหน้าที่' %></span></td><td><span class="badge <%= user.status === 'Active' ? 'success' : 'muted' %>"><%= user.status === 'Active' ? 'ใช้งาน' : 'ปิดใช้งาน' %></span></td></tr><% }) %></tbody>
</table></div>
<p class="surface-note">หน้านี้ใช้ตรวจสอบบัญชีและสิทธิ์ การเพิ่มบัญชีหรือแก้ไขสิทธิ์ผ่านหน้าจอยังไม่เปิดใช้งาน</p>
<%- include('../partials/shell-end') %>
