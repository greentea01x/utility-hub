<%- include('../partials/shell-start') %>
<div class="page-intro">
  <div><p class="section-kicker">ข้อมูลผู้พักอาศัย</p><h1>ผู้เช่า</h1><p>ข้อมูลติดต่อผู้เช่าและสถานะการเชื่อมต่อ LINE สำหรับการแจ้งเตือน</p></div>
  <span class="count-label"><%= tenants.length %> รายการ</span>
</div>
<div class="table-wrap"><table>
  <thead><tr><th>ห้อง</th><th>ชื่อผู้เช่า</th><th>เบอร์โทรศัพท์</th><th>การเชื่อมต่อ LINE</th><th>สถานะ</th></tr></thead>
  <tbody>
    <% if (!tenants.length) { %><tr><td class="empty-cell" colspan="5">ยังไม่มีผู้เช่าในรายการนี้</td></tr><% } %>
    <% tenants.forEach((tenant) => { %>
      <tr><td><strong><%= tenant.room_number %></strong></td><td><%= tenant.full_name %></td><td><%= tenant.phone %></td><td><span class="badge <%= tenant.line_user_id ? 'success' : 'muted' %>"><%= tenant.line_user_id ? 'ผูก LINE แล้ว' : 'ยังไม่ผูก LINE' %></span></td><td><span class="badge <%= tenant.status === 'Active' ? 'success' : 'muted' %>"><%= tenant.status === 'Active' ? 'กำลังเข้าพัก' : 'สิ้นสุดการเข้าพัก' %></span></td></tr>
    <% }) %>
  </tbody>
</table></div>
<p class="surface-note">สถานะการผูก LINE ใช้เตรียมรายชื่อผู้รับแจ้งเตือน ส่วนการส่งข้อความผ่าน LINE ยังไม่เปิดใช้งาน</p>
<%- include('../partials/shell-end') %>
