<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>ผู้พักอาศัย</h1><table><thead><tr><th>ห้อง</th><th>ชื่อ</th><th>โทรศัพท์</th><th>LINE</th><th>สถานะ</th></tr></thead><tbody><% tenants.forEach((tenant) => { %><tr><td><%= tenant.room_number %></td><td><%= tenant.full_name %></td><td><%= tenant.phone %></td><td><%= tenant.line_user_id ? 'ผูกแล้ว' : 'ยังไม่ผูก' %></td><td><%= tenant.status %></td></tr><% }) %></tbody></table></main></body></html>
