<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><main><section class="auth"><h1>เข้าสู่ระบบ</h1><p>ระบบจัดการค่าสาธารณูปโภคและค่าส่วนกลาง</p><% if (typeof error !== 'undefined') { %><p role="alert"><%= error %></p><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>ชื่อผู้ใช้<input name="username" value="<%= username ?? '' %>" autocomplete="username" required></label><label>รหัสผ่าน<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">เข้าสู่ระบบ</button></form></section></main></body></html>
