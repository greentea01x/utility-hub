<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1><%= title %></h1><p>รอบบิล <%= period %></p><p><a href="/reports/arrears?period=<%= period %>&format=csv">ดาวน์โหลด CSV</a></p><table><thead><tr><th>ห้อง</th><th>ผู้พักอาศัย</th><th>ยอดค้าง</th><th>ครบกำหนด</th></tr></thead><tbody><% rows.forEach((row) => { %><tr><td><%= row.room_number %></td><td><%= row.full_name ?? '-' %></td><td><%= row.total %></td><td><%= row.due_date %></td></tr><% }) %></tbody></table></main></body></html>
