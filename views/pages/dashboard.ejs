<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Juristic Platform</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <header>
    <a href="/dashboard">UtilityHub</a><span>Juristic Platform</span>
    <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form>
  </header>
  <main>
    <p class="eyebrow">ภาพรวม</p>
    <h1>ยินดีต้อนรับ, <%= session.user.displayName %></h1>
    <% if (summary) { %>
      <p>รอบจดมิเตอร์ <%= summary.period %> · ห้องพักทั้งหมด <%= summary.rooms_total %> ห้อง · มีผู้พักอาศัย <%= summary.rooms_occupied %> ห้อง</p>
      <p role="status">จดมิเตอร์ครบแล้ว <%= summary.readings_complete %> ห้อง · รอจดมิเตอร์ <%= summary.readings_remaining %> ห้อง</p>
    <% } else { %>
      <p>จัดการรอบบิลจากการจดมิเตอร์จนถึงออกใบเสร็จ</p>
    <% } %>
    <nav class="page-nav" aria-label="งานหลัก">
      <% navigation.forEach((page) => { %>
        <a href="<%= page.href %>"><%= page.label %></a>
      <% }) %>
    </nav>
  </main>
</body>
</html>
