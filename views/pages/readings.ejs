<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>จดมิเตอร์</h1><p>รอบบิล <%= period %></p><table><thead><tr><th>ห้อง</th><th>น้ำ</th><th>ไฟฟ้า</th></tr></thead><tbody><% rooms.forEach((room) => { %><tr><td><%= room.room_number %></td><td><input aria-label="น้ำ ห้อง <%= room.room_number %>" data-room-id="<%= room.id %>" data-utility="water" type="number" min="0"></td><td><input aria-label="ไฟฟ้า ห้อง <%= room.room_number %>" data-room-id="<%= room.id %>" data-utility="electric" type="number" min="0"></td></tr><% }) %></tbody></table></main></body></html>
