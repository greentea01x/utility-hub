<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>ตั้งค่า</h1><p><%= settings.apartment_name %> · ครบกำหนดวันที่ <%= settings.due_day %></p><h2>อัตราปัจจุบันและประวัติ</h2><table><thead><tr><th>ประเภท</th><th>ราคา</th><th>เริ่มใช้</th></tr></thead><tbody><% rates.forEach((rate) => { %><tr><td><%= rate.utility_type %></td><td><%= rate.unit_price %></td><td><%= rate.effective_from %></td></tr><% }) %></tbody></table></main></body></html>
