<%- include('../partials/shell-start') %>
<div class="page-intro"><div><p class="section-kicker">การจัดการระบบ</p><h1>ตั้งค่า</h1><p>ข้อมูลอาคาร รอบชำระเงิน และประวัติอัตราค่าบริการที่ใช้คำนวณบิล</p></div></div>
<section class="panel workspace-section mobile-building-settings" aria-labelledby="building-settings-heading">
  <div class="section-heading"><div><h2 id="building-settings-heading">ข้อมูลอาคารและการชำระเงิน</h2><p>ข้อมูลปัจจุบันที่บันทึกไว้ในระบบ</p></div><span class="badge muted">ดูข้อมูล</span></div>
  <div class="form-grid"><div><p class="field-help">ชื่ออาคาร</p><h3><%= settings.apartment_name %></h3></div><div><p class="field-help">วันครบกำหนดชำระรายเดือน</p><h3>วันที่ <%= settings.due_day %> ของทุกเดือน</h3></div></div>
</section>
<section aria-labelledby="rates-heading">
  <div class="table-toolbar"><div><h2 id="rates-heading">อัตราค่าบริการและประวัติ</h2><p class="field-help">ระบบใช้อัตราที่มีผลตามวันที่เริ่มใช้ของแต่ละรายการ</p></div></div>
  <div class="table-wrap mobile-card-wrap"><table class="mobile-card-table mobile-rates-table" role="table" aria-labelledby="rates-heading">
    <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">ประเภทค่าบริการ</th><th scope="col" role="columnheader" class="num">อัตราค่าบริการ</th><th scope="col" role="columnheader">เริ่มใช้</th></tr></thead>
    <tbody role="rowgroup"><% if (!rates.length) { %><tr role="row"><td role="cell" class="empty-cell" colspan="3">ยังไม่มีอัตราค่าบริการในระบบ</td></tr><% } %><% rates.forEach((rate) => { %><tr role="row"><td role="cell" class="mobile-card-primary" data-mobile-label="ประเภทค่าบริการ"><strong><%= rate.utility_type === 'water' ? 'ค่าน้ำประปา' : rate.utility_type === 'electric' ? 'ค่าไฟฟ้า' : 'ค่าส่วนกลาง' %></strong></td><td role="cell" class="num mobile-card-amount" data-mobile-label="อัตราค่าบริการ"><%= money(rate.unit_price) %> บาท / <%= rate.utility_type === 'common' ? 'ตร.ม.' : 'หน่วย' %></td><td role="cell" data-mobile-label="เริ่มใช้"><%= displayDate(rate.effective_from) %></td></tr><% }) %></tbody>
  </table></div>
</section>
<p class="surface-note">หน้านี้แสดงข้อมูลปัจจุบันและประวัติอัตราค่าบริการ การแก้ไขผ่านหน้าจอยังไม่เปิดใช้งาน</p>
<%- include('../partials/shell-end') %>
