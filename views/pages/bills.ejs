<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>บิลรายเดือน</h1><p>รอบบิล <%= period %></p><table><thead><tr><th>ห้อง</th><th>สถานะ</th><th>ยอดรวม</th><th>ครบกำหนด</th></tr></thead><tbody><% bills.forEach((bill) => { %><tr><td><%= bill.room_number %></td><td><%= bill.status %></td><td><%= bill.total %></td><td><%= bill.due_date %></td></tr><% }) %></tbody></table></main></body></html>
