<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Juristic Platform</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <header>
    <a href="/dashboard">UtilityHub</a><span>Juristic Platform</span>
    <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form>
  </header>
  <main>
    <nav class="breadcrumbs"><a href="/dashboard">ภาพรวม</a> / บิลรายเดือน</nav>
    <h1>บิลรายเดือน</h1>
    <p>รอบบิล <%= period %></p>
    <form action="/bills/generate" method="post" class="action-bar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="period" value="<%= period %>">
      <button type="submit">สร้าง/อัปเดตบิลฉบับร่าง</button>
    </form>
    <div class="table-wrap">
      <table>
        <thead><tr><th>ห้อง</th><th>สถานะ</th><th>ยอดรวม</th><th>ครบกำหนด</th><th>ดำเนินการ</th></tr></thead>
        <tbody>
          <% bills.forEach((bill) => { %>
            <tr data-room="<%= bill.room_number %>" data-bill-id="<%= bill.id %>">
              <td><%= bill.room_number %></td>
              <td><%= bill.status %></td>
              <td><%= bill.total %></td>
              <td><%= bill.due_date %></td>
              <td>
                <% if (bill.status === 'Draft' && session.user.role === 'admin') { %>
                  <form action="/bills/<%= bill.id %>/approve" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="period" value="<%= period %>">
                    <button type="submit">อนุมัติบิล</button>
                  </form>
                <% } else if (bill.status === 'Unpaid') { %>
                  <form action="/bills/<%= bill.id %>/pay" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">รับชำระเงินสด</button>
                  </form>
                <% } else if (bill.receipt_id) { %>
                  <a href="/receipts/<%= bill.receipt_id %>">ดูใบเสร็จ</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
