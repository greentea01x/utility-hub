<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>ห้องพัก</h1><p>ทั้งหมด <%= total %> ห้อง</p><table><thead><tr><th>ห้อง</th><th>ชั้น</th><th>พื้นที่</th><th>สถานะ</th></tr></thead><tbody><% rows.forEach((room) => { %><tr><td><%= room.room_number %></td><td><%= room.floor %></td><td><%= room.area_sqm %> ตร.ม.</td><td><%= room.status %></td></tr><% }) %></tbody></table></main></body></html>
