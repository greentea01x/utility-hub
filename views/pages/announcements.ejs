<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Juristic Platform</title><link rel="stylesheet" href="/css/app.css"></head><body><header><a href="/dashboard">UtilityHub</a><span>Juristic Platform</span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ออกจากระบบ</button></form></header><main><h1>ประกาศ</h1><form method="post" action="/announcements"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>หัวข้อ<input name="title" maxlength="60" required></label><label>ข้อความ<textarea name="body" maxlength="400" required></textarea></label><button>เผยแพร่ประกาศ</button></form><h2>ประกาศที่ผ่านมา</h2><% announcements.forEach((announcement) => { %><article><h3><%= announcement.title %></h3><p><%= announcement.body %></p></article><% }) %></main></body></html>
